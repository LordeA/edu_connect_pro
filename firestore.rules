rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: only the user can read/write their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Courses: public read; create/update/delete only by teacher who owns it
    match /cours/{courseId} {
      allow read: if true;
      allow create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      allow update, delete: if request.auth != null && resource.data.teacherId == request.auth.uid;

      // Chapters subcollection
      match /chapitres/{chapterId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/cours/$(courseId)).data.teacherId == request.auth.uid;
      }
    }

    // Inscriptions: students can create their own inscription doc id: '{studentId}_{courseId}'
    match /inscriptions/{insId} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid && insId == (request.auth.uid + '_' + request.resource.data.courseId);
      allow read: if request.auth != null && (resource.data.studentId == request.auth.uid || get(/databases/$(database)/documents/cours/$(resource.data.courseId)).data.teacherId == request.auth.uid);
      allow update: if request.auth != null && resource.data.studentId == request.auth.uid;
    }

    // Quiz results: enforce single submission by requiring doc id '{quizId}_{studentId}'
    match /quiz_results/{resultId} {
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid
        && resultId == (request.resource.data.quizId + '_' + request.auth.uid);
      allow read: if request.auth != null && (resource.data.studentId == request.auth.uid || get(/databases/$(database)/documents/cours/$(resource.data.courseId)).data.teacherId == request.auth.uid);
    }

    // Course quizzes collection
    match /cours_quizes/{quizId} {
      allow read: if true;
      allow create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/cours/$(request.resource.data.courseId)).data.teacherId == request.auth.uid;
    }
  }
}
