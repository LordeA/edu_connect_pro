rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    match /cours/{courseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.teacherId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inscritCount'])
      );
      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;

      match /chapitres/{chapterId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && get(/databases/$(database)/documents/cours/$(courseId)).data.teacherId == request.auth.uid;
      }

      match /quizes/{quizId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && get(/databases/$(database)/documents/cours/$(courseId)).data.teacherId == request.auth.uid;
      }
    }

    match /inscriptions/{inscriptionId} {
      allow read, write: if request.auth != null;
    }

    match /quiz_results/{resultId} {
      allow read, write: if request.auth != null;
    }
  }
}